APP_ENV=local
# Local development creates random private values in .local/ when omitted.
# Hosting requires explicit DJANGO_SECRET_KEY (50+ characters) and
# PREVIEW_ACCESS_CODE (24+ characters), stored in Render environment settings.
# Never commit actual secret values or copy a payroll database into this project.

# APP_ENV=development uses personal accounts in a separate local database.
# APP_ENV=production requires persistent PostgreSQL, verified email and Turnstile.
# See PRODUCTION_SETUP.md before switching the hosted service.
# BOOTSTRAP_OWNER_EMAIL=
# BOOTSTRAP_OWNER_NAME=
# BOOTSTRAP_OWNER_TOKEN=  # private random value, 32+ characters; first startup only

# Optional: send claim submissions to one confirmed reviewer via Mailjet.
# Leave as preview until the complete recipient and verified sender are confirmed.
# Preview account/invitation emails remain local. Seed data never sends notifications.
TIMESHEET_EMAIL_DELIVERY=preview
# TIMESHEET_MAILJET_API_KEY=
# TIMESHEET_MAILJET_API_SECRET=
# TIMESHEET_FROM_EMAIL=
# TIMESHEET_NOTIFICATION_EMAIL=
